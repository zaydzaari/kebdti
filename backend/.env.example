# Copy to backend/.env and fill in your own keys. Never commit the real .env.
# Translation (GPT-6 Luna) through an OpenAI-compatible gateway: either one works
STRAITLY_API_KEY=
ZENMUX_API_KEY=
# Speech recognition (Gemini). One key, or several separated by commas
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Voices
FISH_API_KEY=
ELEVENLABS_API_KEY=
# Optional: an ElevenLabs voice cloned WITH CONSENT for the family's grandmother
ELEVENLABS_GRANDMA_VOICE_ID=
# Which voice engine speaks each language for the grandmother
GRANDMA_VOICE_BY_LANG=darija:fish,fr:eleven_v2,es:eleven_v2,it:eleven_v2,en:eleven_v2
